<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- NcomArch.Shell: the NCOM Arch shell service. Hosts the window-system core and serves it on
       \\.\pipe\ncom-arch. Runs as a console app or as a Windows Service. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NcomArch.Shell</RootNamespace>
    <AssemblyName>NcomArch.Shell</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NcomArch.Interop/NcomArch.Interop.csproj" />
  </ItemGroup>
</Project>
